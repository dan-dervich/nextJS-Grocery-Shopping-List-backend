# URL of your pockethost.io instance, e.g. https://your-app.pockethost.io
POCKETBASE_URL=

# Superuser (admin) credentials for the pocketbase instance above.
# The API authenticates as this superuser so it can read/write the
# "families" and "groceries" collections regardless of their API rules.
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

PORT=3001
